//@version=5
indicator("Supertrend Custom", overlay=true)

// === Input ===
atrLen   = input.int(10, "ATR Length", minval=1)
factor   = input.float(3.0, "Factor (Multiplier)", minval=0.1, step=0.1)
useRma   = input.bool(true, "Gunakan ATR (RMA), nonaktif = SMA of TR")
showSig  = input.bool(true, "Tampilkan sinyal Buy/Sell")
fillBg   = input.bool(true, "Warnai area tren")

// === Perhitungan ===
atr = useRma ? ta.atr(atrLen) : ta.sma(ta.tr, atrLen)
hl2v = (high + low) / 2

upperBasic = hl2v + factor * atr
lowerBasic = hl2v - factor * atr

var float upper = na
var float lower = na
var int   dir   = 1   // 1 = bullish, -1 = bearish

prevUpper = nz(upper[1], upperBasic)
prevLower = nz(lower[1], lowerBasic)

// Band hanya boleh menyempit (kecuali harga sebelumnya menembus band)
lower := (lowerBasic > prevLower or close[1] < prevLower) ? lowerBasic : prevLower
upper := (upperBasic < prevUpper or close[1] > prevUpper) ? upperBasic : prevUpper

// Arah tren
dir := close > prevUpper ? 1 : close < prevLower ? -1 : nz(dir[1], 1)

supertrend = dir == 1 ? lower : upper

// === Sinyal ===
buySig  = dir == 1  and dir[1] == -1
sellSig = dir == -1 and dir[1] == 1

// === Plot ===
bullColor = color.new(color.green, 0)
bearColor = color.new(color.red, 0)

midPlot  = plot((open + close) / 2, "Mid", display=display.none)
stUp     = plot(dir == 1  ? supertrend : na, "Uptrend",   color=bullColor, style=plot.style_linebr, linewidth=2)
stDown   = plot(dir == -1 ? supertrend : na, "Downtrend", color=bearColor, style=plot.style_linebr, linewidth=2)

fill(midPlot, stUp,   color=fillBg ? color.new(color.green, 88) : na)
fill(midPlot, stDown, color=fillBg ? color.new(color.red, 88)   : na)

plotshape(showSig and buySig,  "Buy",  shape.labelup,   location.belowbar, bullColor, text="Buy",  textcolor=color.white, size=size.small)
plotshape(showSig and sellSig, "Sell", shape.labeldown, location.abovebar, bearColor, text="Sell", textcolor=color.white, size=size.small)

// === Alert ===
alertcondition(buySig,  "Supertrend Buy",  "Supertrend berubah menjadi BULLISH di {{ticker}} ({{interval}})")
alertcondition(sellSig, "Supertrend Sell", "Supertrend berubah menjadi BEARISH di {{ticker}} ({{interval}})")
alertcondition(buySig or sellSig, "Supertrend Berubah Arah", "Supertrend berubah arah di {{ticker}} ({{interval}})")
