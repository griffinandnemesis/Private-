//@version=6
indicator("Supertrend Pro (MTF + Filters + SL/TP)", overlay=true)

// =====================================================================
// INPUT
// =====================================================================
// --- Supertrend TF chart ---
atrLen = input.int(10, "ATR Length", minval=1, group="Supertrend (TF chart)")
factor = input.float(3.0, "Factor (Multiplier)", minval=0.1, step=0.1, group="Supertrend (TF chart)")
useRma = input.bool(true, "Gunakan ATR (RMA), nonaktif = SMA of TR", group="Supertrend (TF chart)")

// --- Filter MTF ---
useMtf    = input.bool(true, "Aktifkan filter MTF", group="Filter MTF")
htf       = input.timeframe("15", "Timeframe filter", group="Filter MTF")
htfAtrLen = input.int(10, "ATR Length (HTF)", minval=1, group="Filter MTF")
htfFactor = input.float(3.0, "Factor (HTF)", minval=0.1, step=0.1, group="Filter MTF")
htfClosed = input.bool(true, "Pakai bar HTF yang sudah close (anti-repaint)", group="Filter MTF")
showHtf   = input.bool(true, "Tampilkan garis Supertrend HTF", group="Filter MTF")

// --- Filter tambahan ---
useAdx    = input.bool(true, "Filter ADX (anti-sideways)", group="Filter Tambahan")
adxLen    = input.int(14, "ADX Length", minval=1, group="Filter Tambahan")
adxMin    = input.float(20.0, "ADX minimum", minval=1, group="Filter Tambahan")

useEma    = input.bool(true, "Filter EMA (arah tren)", group="Filter Tambahan")
emaLen    = input.int(200, "EMA Length", minval=1, group="Filter Tambahan")

useRsi    = input.bool(true, "Filter RSI (momentum)", group="Filter Tambahan")
rsiLen    = input.int(14, "RSI Length", minval=1, group="Filter Tambahan")
rsiMax    = input.float(75.0, "RSI batas jenuh (Buy < nilai ini, Sell > 100 - nilai ini)", minval=50, maxval=100, group="Filter Tambahan")

useVol    = input.bool(false, "Filter Volume", group="Filter Tambahan")
volLen    = input.int(20, "Volume SMA Length", minval=1, group="Filter Tambahan")
volMult   = input.float(1.0, "Volume minimum (x rata-rata)", minval=0.1, step=0.1, group="Filter Tambahan")

useVwap   = input.bool(false, "Filter VWAP", group="Filter Tambahan")

useSess   = input.bool(false, "Filter jam trading", group="Filter Tambahan")
sessStr   = input.session("1400-0300", "Jam trading", group="Filter Tambahan")
sessTz    = input.string("Asia/Jakarta", "Zona waktu", group="Filter Tambahan")

cooldown  = input.int(0, "Cooldown (bar) setelah sinyal valid", minval=0, group="Filter Tambahan")

// --- SL / TP ---
useTrade  = input.bool(true, "Tampilkan Entry / SL / TP", group="SL / TP")
slMode    = input.string("ATR", "Mode Stop Loss", options=["ATR", "Supertrend"], group="SL / TP")
slMult    = input.float(1.5, "SL = ATR x", minval=0.1, step=0.1, group="SL / TP")
rr        = input.float(2.0, "Take Profit (rasio R:R)", minval=0.1, step=0.1, group="SL / TP")

// --- Tampilan ---
showSig   = input.bool(true, "Tampilkan sinyal Buy/Sell", group="Tampilan")
fillBg    = input.bool(true, "Warnai area tren", group="Tampilan")
showTable = input.bool(true, "Tampilkan tabel status", group="Tampilan")

// =====================================================================
// FUNGSI SUPERTREND (dipakai di TF chart dan HTF)
// =====================================================================
f_st(int len, float mult, bool rma) =>
    atrRma = ta.atr(len)
    atrSma = ta.sma(ta.tr, len)
    a      = rma ? atrRma : atrSma
    h      = (high + low) / 2
    upBasic = h + mult * a
    loBasic = h - mult * a

    var float up = na
    var float lo = na
    var int   d  = 1

    prevUp = nz(up[1], upBasic)
    prevLo = nz(lo[1], loBasic)

    // Band hanya boleh menyempit (kecuali harga sebelumnya menembus band)
    lo := (loBasic > prevLo or close[1] < prevLo) ? loBasic : prevLo
    up := (upBasic < prevUp or close[1] > prevUp) ? upBasic : prevUp

    d := close > prevUp ? 1 : close < prevLo ? -1 : nz(d[1], 1)
    [d == 1 ? lo : up, d]

// Nilai bar sebelumnya (mode anti-repaint)
f_st_prev(int len, float mult, bool rma) =>
    [s, d] = f_st(len, mult, rma)
    [s[1], d[1]]

// =====================================================================
// PERHITUNGAN
// =====================================================================
[supertrend, dir] = f_st(atrLen, factor, useRma)

// --- HTF ---
if timeframe.in_seconds(htf) < timeframe.in_seconds(timeframe.period)
    runtime.error("Timeframe filter harus sama atau lebih besar dari timeframe chart.")

[stLive, dirLive]     = request.security(syminfo.tickerid, htf, f_st(htfAtrLen, htfFactor, useRma), lookahead = barmerge.lookahead_off)
[stClosed, dirClosed] = request.security(syminfo.tickerid, htf, f_st_prev(htfAtrLen, htfFactor, useRma), lookahead = barmerge.lookahead_on)

htfSt  = htfClosed ? stClosed : stLive
htfDir = htfClosed ? dirClosed : dirLive

// --- Indikator filter (dihitung di setiap bar) ---
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
emaVal   = ta.ema(close, emaLen)
rsiVal   = ta.rsi(close, rsiLen)
volAvg   = ta.sma(volume, volLen)
vwapVal  = ta.vwap(hlc3)
atrChart = ta.atr(atrLen)

inSess = not na(time(timeframe.period, sessStr, sessTz))

// --- Kondisi filter ---
adxOk  = not useAdx or adxVal > adxMin
volOk  = not useVol or na(volume) or volume > volAvg * volMult
sessOk = not useSess or inSess

var int lastSigBar = na
coolOk = cooldown == 0 or na(lastSigBar) or bar_index - lastSigBar > cooldown

baseOk   = adxOk and volOk and sessOk and coolOk

emaLong  = not useEma  or close > emaVal
rsiLong  = not useRsi  or (rsiVal > 50 and rsiVal < rsiMax)
vwapLong = not useVwap or close > vwapVal

emaShort  = not useEma  or close < emaVal
rsiShort  = not useRsi  or (rsiVal < 50 and rsiVal > 100 - rsiMax)
vwapShort = not useVwap or close < vwapVal

longOk  = baseOk and emaLong and rsiLong and vwapLong
shortOk = baseOk and emaShort and rsiShort and vwapShort

// --- Sinyal ---
flipUp   = dir == 1  and dir[1] == -1
flipDown = dir == -1 and dir[1] == 1

htfBull = not useMtf or htfDir == 1
htfBear = not useMtf or htfDir == -1

buySig  = flipUp and htfBull and longOk
sellSig = flipDown and htfBear and shortOk

if buySig or sellSig
    lastSigBar := bar_index

rejectUp   = flipUp and not buySig
rejectDown = flipDown and not sellSig

// =====================================================================
// ENTRY / SL / TP + STATISTIK SEDERHANA
// =====================================================================
var int   tDir   = 0
var float tEntry = na
var float tSl    = na
var float tTp    = na
var int   wins   = 0
var int   losses = 0

// Cek hasil trade yang sedang berjalan (SL diprioritaskan jika kena bersamaan)
if tDir == 1
    if low <= tSl
        losses += 1
        tDir := 0
    else if high >= tTp
        wins += 1
        tDir := 0
else if tDir == -1
    if high >= tSl
        losses += 1
        tDir := 0
    else if low <= tTp
        wins += 1
        tDir := 0

// Buka trade baru dari sinyal valid
if buySig
    slLevel = slMode == "ATR" ? close - slMult * atrChart : supertrend
    risk    = close - slLevel
    if risk > 0
        tDir   := 1
        tEntry := close
        tSl    := slLevel
        tTp    := close + rr * risk
else if sellSig
    slLevel = slMode == "ATR" ? close + slMult * atrChart : supertrend
    risk    = slLevel - close
    if risk > 0
        tDir   := -1
        tEntry := close
        tSl    := slLevel
        tTp    := close - rr * risk

// =====================================================================
// PLOT
// =====================================================================
bullColor = color.new(color.green, 0)
bearColor = color.new(color.red, 0)

midPlot = plot((open + close) / 2, "Mid", display = display.none)
stUp    = plot(dir == 1  ? supertrend : na, "Uptrend",   color = bullColor, style = plot.style_linebr, linewidth = 2)
stDown  = plot(dir == -1 ? supertrend : na, "Downtrend", color = bearColor, style = plot.style_linebr, linewidth = 2)

fill(midPlot, stUp,   color = fillBg ? color.new(color.green, 88) : na)
fill(midPlot, stDown, color = fillBg ? color.new(color.red, 88)   : na)

// Supertrend HTF (titik)
plot(showHtf and useMtf and htfDir == 1  ? htfSt : na, "HTF Up",   color = color.new(color.aqua, 20),   style = plot.style_circles, linewidth = 1)
plot(showHtf and useMtf and htfDir == -1 ? htfSt : na, "HTF Down", color = color.new(color.orange, 20), style = plot.style_circles, linewidth = 1)

// EMA filter
plot(useEma ? emaVal : na, "EMA", color = color.new(color.yellow, 30), linewidth = 1)

// Label sinyal valid
plotshape(showSig and buySig,  "Buy",  shape.labelup,   location.belowbar, bullColor, text = "Buy",  textcolor = color.white, size = size.small)
plotshape(showSig and sellSig, "Sell", shape.labeldown, location.abovebar, bearColor, text = "Sell", textcolor = color.white, size = size.small)

// Sinyal yang ditolak filter
plotshape(showSig and rejectUp,   "Buy ditolak",  shape.xcross, location.belowbar, color.new(color.gray, 30), size = size.tiny)
plotshape(showSig and rejectDown, "Sell ditolak", shape.xcross, location.abovebar, color.new(color.gray, 30), size = size.tiny)

// Garis Entry / SL / TP selama trade berjalan
plot(useTrade and tDir != 0 ? tEntry : na, "Entry", color = color.new(color.gray, 20),  style = plot.style_linebr, linewidth = 1)
plot(useTrade and tDir != 0 ? tSl    : na, "SL",    color = color.new(color.red, 20),    style = plot.style_linebr, linewidth = 1)
plot(useTrade and tDir != 0 ? tTp    : na, "TP",    color = color.new(color.green, 20),  style = plot.style_linebr, linewidth = 1)

// =====================================================================
// TABEL STATUS
// =====================================================================
var table info = table.new(position.top_right, 1, 4)
if barstate.islast and showTable
    htfTxt = useMtf ? "HTF " + htf + ": " + (htfDir == 1 ? "BULLISH" : "BEARISH") : "Filter MTF: OFF"
    htfClr = not useMtf ? color.gray : htfDir == 1 ? color.green : color.red
    table.cell(info, 0, 0, htfTxt, text_color = color.white, bgcolor = htfClr)

    adxTxt = useAdx ? "ADX " + str.tostring(adxVal, "#.#") + (adxVal > adxMin ? " (trending)" : " (sideways)") : "ADX filter: OFF"
    adxClr = not useAdx ? color.gray : adxVal > adxMin ? color.green : color.red
    table.cell(info, 0, 1, adxTxt, text_color = color.white, bgcolor = adxClr)

    total = wins + losses
    wr    = total > 0 ? wins / total * 100 : 0.0
    table.cell(info, 0, 2, "TP " + str.tostring(wins) + " / SL " + str.tostring(losses), text_color = color.white, bgcolor = color.new(color.blue, 20))
    table.cell(info, 0, 3, "Winrate " + str.tostring(wr, "#.#") + "%", text_color = color.white, bgcolor = color.new(color.blue, 20))

// =====================================================================
// ALERT
// =====================================================================
alertcondition(buySig,  "Supertrend Buy (valid)",  "BUY valid: Supertrend + MTF + filter di {{ticker}} ({{interval}})")
alertcondition(sellSig, "Supertrend Sell (valid)", "SELL valid: Supertrend + MTF + filter di {{ticker}} ({{interval}})")
alertcondition(buySig or sellSig, "Supertrend Sinyal Valid", "Sinyal valid di {{ticker}} ({{interval}})")
