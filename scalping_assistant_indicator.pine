//@version=5
// Scalping Assistant — indikator sinyal scalping
// Konsep: tren EMA + VWAP, trigger EMA cross / pullback, konfirmasi RSI,
// filter volatilitas ATR, Stop Loss & Take Profit berbasis ATR.
indicator("Scalping Assistant", shorttitle="ScalpAsst", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================== INPUT ==============================
grpT = "1. Tren"
emaFastLen  = input.int(9,   "EMA Cepat",      minval=1, group=grpT)
emaSlowLen  = input.int(21,  "EMA Lambat",     minval=1, group=grpT)
emaTrendLen = input.int(200, "EMA Tren Besar", minval=1, group=grpT)
useVwap     = input.bool(true, "Gunakan filter VWAP", group=grpT, tooltip="BUY hanya di atas VWAP, SELL hanya di bawah VWAP. Otomatis diabaikan jika simbol tidak punya data volume.")

grpM = "2. Momentum (RSI)"
rsiLen     = input.int(14, "Panjang RSI", minval=2, group=grpM)
rsiBuyMin  = input.int(50, "RSI minimal untuk BUY", group=grpM)
rsiSellMax = input.int(50, "RSI maksimal untuk SELL", group=grpM)
rsiOb      = input.int(70, "Overbought (jangan BUY di atas ini)", group=grpM)
rsiOs      = input.int(30, "Oversold (jangan SELL di bawah ini)", group=grpM)

grpF = "3. Filter"
useAtrFilter  = input.bool(true, "Hindari pasar sepi (filter ATR)", group=grpF)
atrLen        = input.int(14, "Panjang ATR", minval=1, group=grpF)
atrFilterLen  = input.int(50, "Rata-rata ATR", minval=1, group=grpF)
atrFilterMult = input.float(0.8, "ATR minimal = rata-rata x", step=0.1, group=grpF)
useVolFilter  = input.bool(false, "Filter volume di atas rata-rata", group=grpF)
volLen        = input.int(20, "Rata-rata volume", minval=1, group=grpF)
useSession    = input.bool(false, "Hanya trading di jam sesi", group=grpF)
sessionStr    = input.session("1400-2300", "Jam sesi", group=grpF, tooltip="Default 14:00-23:00 WIB = sesi London + New York.")
sessionTz     = input.string("Asia/Jakarta", "Zona waktu sesi", group=grpF)
cooldown      = input.int(5, "Jeda minimal antar sinyal (bar)", minval=0, group=grpF)

grpR = "4. Manajemen Risiko"
slMult     = input.float(1.5, "Stop Loss = ATR x", minval=0.1, step=0.1, group=grpR)
rr         = input.float(1.5, "Risk : Reward (TP = SL x)", minval=0.1, step=0.1, group=grpR)
showLevels = input.bool(true, "Tampilkan garis Entry/SL/TP", group=grpR)
levelBars  = input.int(15, "Panjang garis (bar)", minval=1, group=grpR)

grpD = "5. Tampilan"
showEmas = input.bool(true, "Tampilkan EMA", group=grpD)
showBg   = input.bool(true, "Warnai latar sesuai tren", group=grpD)
showDash = input.bool(true, "Tampilkan panel info", group=grpD)

// ============================== HITUNGAN ==============================
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)
vwapVal  = ta.vwap(hlc3)
rsi      = ta.rsi(close, rsiLen)
atr      = ta.atr(atrLen)
atrAvg   = ta.sma(atr, atrFilterLen)
volAvg   = ta.sma(volume, volLen)

hasVwap  = not na(vwapVal)
vwapBull = not useVwap or not hasVwap or close > vwapVal
vwapBear = not useVwap or not hasVwap or close < vwapVal

// Tren: harga di sisi EMA 200, EMA cepat di atas/bawah EMA lambat, searah VWAP
bullTrend = close > emaTrend and emaFast > emaSlow and vwapBull
bearTrend = close < emaTrend and emaFast < emaSlow and vwapBear

// Trigger: EMA cross, atau pullback ke EMA cepat lalu memantul
crossUp   = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)
bounceUp   = low <= emaFast and close > emaFast and close > open
bounceDown = high >= emaFast and close < emaFast and close < open
buyTrigger  = crossUp or bounceUp
sellTrigger = crossDown or bounceDown

// Momentum
bullMom = rsi > rsiBuyMin and rsi < rsiOb
bearMom = rsi < rsiSellMax and rsi > rsiOs

// Filter
activeOk  = not useAtrFilter or atr > atrAvg * atrFilterMult
volOk     = not useVolFilter or na(volAvg) or volume > volAvg
sessionOk = not useSession or not na(time(timeframe.period, sessionStr, sessionTz))

var int lastSignalBar = na
cooldownOk = na(lastSignalBar) or bar_index - lastSignalBar > cooldown

filtersOk  = activeOk and volOk and sessionOk and cooldownOk and barstate.isconfirmed
buySignal  = filtersOk and buyTrigger and bullTrend and bullMom
sellSignal = filtersOk and sellTrigger and bearTrend and bearMom

// Level SL / TP
slDist = atr * slMult
buySL  = close - slDist
buyTP  = close + slDist * rr
sellSL = close + slDist
sellTP = close - slDist * rr

var string lastSignal = "-"
if buySignal or sellSignal
    lastSignalBar := bar_index
    lastSignal := buySignal ? "BUY @ " + str.tostring(close, format.mintick) : "SELL @ " + str.tostring(close, format.mintick)

drawLevels(float entry, float sl, float tp) =>
    x2 = bar_index + levelBars
    line.new(bar_index, entry, x2, entry, color=color.gray, style=line.style_dotted)
    line.new(bar_index, sl, x2, sl, color=color.red, width=2)
    line.new(bar_index, tp, x2, tp, color=color.green, width=2)
    label.new(x2, sl, "SL " + str.tostring(sl, format.mintick), style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
    label.new(x2, tp, "TP " + str.tostring(tp, format.mintick), style=label.style_label_left, color=color.new(color.green, 20), textcolor=color.white, size=size.small)

if showLevels and buySignal
    drawLevels(close, buySL, buyTP)
if showLevels and sellSignal
    drawLevels(close, sellSL, sellTP)

// ============================== TAMPILAN ==============================
plot(showEmas ? emaFast : na,  "EMA Cepat",      color=color.new(color.aqua, 0))
plot(showEmas ? emaSlow : na,  "EMA Lambat",     color=color.new(color.orange, 0))
plot(showEmas ? emaTrend : na, "EMA Tren Besar", color=color.new(color.white, 0), linewidth=2)
plot(useVwap ? vwapVal : na,   "VWAP",           color=color.new(color.fuchsia, 0), style=plot.style_circles, linewidth=1)

bgcolor(showBg and bullTrend ? color.new(color.green, 92) : showBg and bearTrend ? color.new(color.red, 92) : na)

plotshape(buySignal,  "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color.new(color.red, 0),   text="SELL", textcolor=color.white, size=size.small)

var table dash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 25), border_width=1, border_color=color.new(color.gray, 60))
if showDash and barstate.islast
    trendTxt = bullTrend ? "NAIK" : bearTrend ? "TURUN" : "NETRAL / tunggu"
    trendCol = bullTrend ? color.lime : bearTrend ? color.red : color.gray
    table.cell(dash, 0, 0, "Tren",        text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, trendTxt,      text_color=trendCol,    text_size=size.small)
    table.cell(dash, 0, 1, "RSI",         text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(rsi, "#.0"), text_color=rsi > rsiOb or rsi < rsiOs ? color.orange : color.white, text_size=size.small)
    table.cell(dash, 0, 2, "Volatilitas", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, activeOk ? "Cukup" : "Terlalu sepi", text_color=activeOk ? color.lime : color.orange, text_size=size.small)
    table.cell(dash, 0, 3, "Sesi",        text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, sessionOk ? "Aktif" : "Di luar sesi", text_color=sessionOk ? color.lime : color.orange, text_size=size.small)
    table.cell(dash, 0, 4, "Sinyal akhir", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, lastSignal,    text_color=color.white, text_size=size.small)

// ============================== ALERT ==============================
alertcondition(buySignal,  "Scalping BUY",  "BUY {{ticker}} di {{close}}")
alertcondition(sellSignal, "Scalping SELL", "SELL {{ticker}} di {{close}}")

if buySignal
    alert("BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(buySL, format.mintick) + " | TP " + str.tostring(buyTP, format.mintick), alert.freq_once_per_bar_close)
if sellSignal
    alert("SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(sellSL, format.mintick) + " | TP " + str.tostring(sellTP, format.mintick), alert.freq_once_per_bar_close)
